			"zakyatto.easyrods.EasyRods"
		]
	},
	"mixins": [
		"easy-rods.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
